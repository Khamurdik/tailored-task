{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,

    // Relative imports inside `src/` carry explicit `.ts` extensions so that
    // `node src/registry/cli.ts` and `node src/history/cli.ts` resolve under
    // Node's type stripping, which has no compiler and no extension guessing.
    // Legal here only because this project emits nothing.
    "allowImportingTsExtensions": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "types": ["node", "vitest/globals"],

    "paths": {
      "@api/*": ["../apps/api/src/*"],
      "@web/*": ["../apps/web/src/*"],
      "@support/*": ["./src/support/*"]
    }
  },
  "include": ["src", "suites", "vitest.config.ts", "playwright.config.ts", "eslint.config.mjs"]
}
