{
  "name": "@dataroom/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every test in the system. Declared first, implemented second.",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:contract": "vitest run --project contract",
    "test:unit": "vitest run --project api-unit --project web-unit",
    "test:integration": "vitest run --project api-integration",
    "test:e2e": "node src/support/e2e-prepare.ts && playwright test",
    "test:cov": "vitest run --coverage",
    "history": "node src/history/cli.ts",
    "history:diff": "node src/history/cli.ts diff",
    "declared": "node src/registry/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {},
  "devDependencies": {
    "@dataroom/shared": "workspace:*",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/testing": "11.2.1",
    "@nestjs/throttler": "6.5.0",
    "cron": "4.4.0",
    "@prisma/client": "6.19.3",
    "axios": "1.19.0",
    "@playwright/test": "1.62.1",
    "@swc/core": "1.16.0",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@hookform/resolvers": "5.9.0",
    "@types/react": "19.2.18",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unplugin-swc": "1.5.11",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
