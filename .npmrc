# Fail fast if the Node version does not satisfy "engines".
#
# THIS LINE DOES NOTHING under pnpm 11 — it reads its settings from
# pnpm-workspace.yaml, where the working key is `engineStrict: true`. Kept only
# so npm/yarn users get the same behaviour; deleting it changes nothing.
# Verified 2026-08-18: with only this line, `pnpm config get engine-strict`
# returns `undefined` and a violating install warns and exits 0.
engine-strict=true

# Several packages (notably @hookform/resolvers) declare a large optional peer
# set covering every validation library. Strict mode turns those into install
# errors for peers we deliberately do not use.
strict-peer-dependencies=false

# Keep the workspace package linked rather than resolved from a registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Deterministic installs in CI.
resolution-mode=highest
