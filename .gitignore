# ---------- dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ---------- build output ----------
dist/
build/
out/
.output/
*.tsbuildinfo

# ---------- monorepo / tooling caches ----------
.turbo/
.nx/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.vite/
.swc/

# ---------- framework output ----------
.next/
.nuxt/
.vercel/
.netlify/
.astro/

# ---------- environment ----------
# Committing a real .env leaks DB URLs and S3 credentials.
# Track .env.example instead and keep it in sync.
.env
.env.*
!.env.example
!.env.*.example

# ---------- secrets / credentials ----------
*.pem
*.key
*.p12
*.pfx
.aws/
.npmrc.local

# ---------- prisma ----------
# Generated client. Regenerated by `prisma generate`; never hand-edited.
# Migrations under prisma/migrations/ ARE tracked and must stay tracked.
prisma/generated/
**/prisma/generated/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------- tests / coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ---------- logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- editors ----------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ---------- os ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- local agent / tool overrides ----------
.claude/settings.local.json

# ---------- scratch ----------
tmp/
temp/
scratch/
*.local
