# Copy to .env.local — never commit the real file.
# Vite only exposes variables prefixed VITE_ to the client bundle. Anything in
# this file is public by definition; no secret belongs here.

# Where the API lives. Leave unset to use the dev proxy in vite.config.ts.
VITE_API_URL=http://localhost:3000

# --- Data source ------------------------------------------------------------
# mock — answer every request from fixtures held in memory. No API, no
#        database, no bucket needed. The swap happens at the axios *adapter*,
#        so interceptors, refresh, schema parsing and react-query all still run
#        for real. See apps/web/src/shared/mock/TODO.md.
# live — talk to the API at VITE_API_URL. The default.
#
# Ignored in a production build: `import.meta.env.PROD` forces this off, so a
# stray `mock` in a deployed environment cannot serve fixtures to real users.
VITE_API_MODE=live

# Google sign-in — OPTIONAL.
# Leave blank and the "Sign in with Google" button is not rendered at all, so a
# checkout without Google credentials still runs and serves password login.
# This is a public client id, not a secret. The matching GOOGLE_CLIENT_ID in
# apps/api/.env is what actually verifies the token.
VITE_GOOGLE_CLIENT_ID=
