# Copy to .env.local — never commit the real file.
# Vite only exposes variables prefixed VITE_ to the client bundle. Anything in
# this file is public by definition; no secret belongs here.

# Where the API lives. Leave unset to use the dev proxy in vite.config.ts.
VITE_API_URL=http://localhost:3000

# Google sign-in — OPTIONAL.
# Leave blank and the "Sign in with Google" button is not rendered at all, so a
# checkout without Google credentials still runs and serves password login.
# This is a public client id, not a secret. The matching GOOGLE_CLIENT_ID in
# apps/api/.env is what actually verifies the token.
VITE_GOOGLE_CLIENT_ID=
