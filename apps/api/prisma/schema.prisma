// Models arrive with the module that owns them, in build order. `users` is
// here; `nodes`, `shares`, `refresh_tokens` and `job_runs` land with theirs.
//
// `nodes` in particular is waiting on a decision rather than on typing: the
// table is one self-referencing relation, but how ancestry is made queryable
// (materialized path, recursive CTE, closure table) is deliberately still open
// and belongs to that module. See apps/api/src/nodes/TODO.md §Storage.
//
// Staying on Prisma 6 (not 7) is a compatibility decision — see docs/TOOLCHAIN.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // citext  — case-insensitive email lookup without lower() at every call site
  //           (users/TODO.md)
  // pg_trgm — GIN index behind room-scoped name search (search/TODO.md)
  extensions = [citext, pg_trgm]
}

/// Owned by `users`. Provisioned from `.env` by the seeder — no HTTP request in
/// the system creates a row here.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// `citext`, not `lower()` at every call site. Case-insensitive comparison
  /// belongs in the column's type: put it in the queries instead and the one
  /// query that forgets is a duplicate account, discovered much later.
  ///
  /// NFC normalization is still the application's job — `citext` folds case,
  /// not Unicode composition.
  email String @unique @db.Citext

  /// Nullable: a user provisioned for Google-only access has no password.
  /// `auth` must read null as "no password login", never as "any password
  /// matches" — which is the bug this comment exists to prevent.
  passwordHash String? @map("password_hash")

  name String

  /// Unique, so two users cannot claim one Google identity. Stored on first
  /// successful Google login and matched on thereafter, because a person can
  /// change the email on their Google account and `sub` is the only stable
  /// identifier.
  googleSub String? @unique @map("google_sub")

  /// Gates the `/jobs` endpoints and nothing else. Set only by the seeder:
  /// there is no endpoint that grants it and no way for a user to escalate
  /// into it.
  isAdmin Boolean @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nodes          Node[]
  sharesCreated  Share[]        @relation("ShareCreator")
  sharesReceived Share[]        @relation("SharePrincipal")
  refreshTokens  RefreshToken[]

  @@map("users")
}

enum NodeType {
  room
  folder
  file

  @@map("node_type")
}

enum NodeState {
  pending
  active

  @@map("node_state")
}

/// Owned by `nodes`. Rooms, folders and files are one self-referencing table
/// discriminated by `type`.
///
/// **`parent_id` is the source of truth for ancestry.** `path` is a derived
/// index over it — rebuildable by `rebuildSubtree`, and the reason six of the
/// eight system-wide invariants exist. The materialized path was chosen over a
/// recursive CTE and a closure table because every cascade in this system is a
/// prefix operation: soft-delete, subtree stats and share scoping are all one
/// predicate against it. See apps/api/src/nodes/TODO.md §Storage.
///
/// Nothing outside `nodes` may name `path`. The module publishes an ancestor
/// **list**, so a later change of strategy stays inside this one file.
model Node {
  id String @id @default(uuid()) @db.Uuid

  type  NodeType
  state NodeState @default(active)

  /// The room this belongs to. A room is its own root.
  rootId String @map("root_id") @db.Uuid

  /// Null only for a room. `Restrict` rather than `Cascade`: deletion here is
  /// always soft, and a database-level cascade would silently make a hard
  /// delete of a room destroy its subtree outside the transaction that logs it.
  parentId String? @map("parent_id") @db.Uuid
  parent   Node?   @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Node[]  @relation("NodeChildren")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  /// NFC-normalized and sanitized before it ever reaches this column. Unique
  /// among live siblings, enforced by a partial index — see the migration.
  name String

  /// `/id/id/id`, ancestors first, ending in self. Never user-controlled: a `%`
  /// or `_` in a name would break every prefix query, and prefix matching is
  /// only unambiguous because every segment is a fixed-width UUID.
  path String

  /// Ancestor count. 0 for a room, capped at 32.
  depth Int

  /// Files only. Authoritative value comes from S3's HeadObject, never a client.
  sizeBytes   Int?    @map("size_bytes")
  contentType String? @map("content_type")

  /// Denormalized rollups for anything rendered in a list. A daily job
  /// reconciles them; drift in a denormalized counter is the classic failure of
  /// this pattern, so it is detected rather than assumed away.
  subtreeFiles Int    @default(0) @map("subtree_files")
  subtreeBytes BigInt @default(0) @map("subtree_bytes")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  shares Share[]

  @@index([rootId])
  @@map("nodes")
}

enum ShareKind {
  public_link
  user

  @@map("share_kind")
}

enum Role {
  none
  viewer
  editor
  owner

  @@map("role")
}

/// Owned by `access`. Grants, and the credentials that reach them.
///
/// `access` sits below `sharing` and `links` on purpose: a share controller needs
/// the "only an owner may share this" guard, and that guard needs to read
/// grants. One module holding both is a cycle. Putting the table and the
/// resolver in the lower layer breaks it, and the payoff is that `resolveAccess`
/// becomes a pure function — so the whole permission matrix is a millisecond
/// unit test instead of an e2e suite.
model Share {
  id String @id @default(uuid()) @db.Uuid

  nodeId String @map("node_id") @db.Uuid
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  kind ShareKind
  role Role      @default(viewer)

  /// SHA-256 of the 43-character token. The plaintext exists in exactly one
  /// response and is never readable again.
  tokenHash String? @unique @map("token_hash")

  /// SHA-256 of the optional 16-character short code — a second spelling of the
  /// same grant. A column rather than a table so revocation has one place to
  /// reach. Opt-in, because a grant is only as strong as its weakest credential
  /// and a code takes this share from 256 bits to 80.
  shortCodeHash String? @unique @map("short_code_hash")

  /// For a `user` grant. `principal_email` is set before the account exists —
  /// `sharing` binds it at that user's next login, which is the only binding
  /// mechanism there is (see HANDOFF §3.13).
  principalUserId String? @map("principal_user_id") @db.Uuid
  principalUser   User?   @relation("SharePrincipal", fields: [principalUserId], references: [id], onDelete: Cascade)
  principalEmail  String? @map("principal_email") @db.Citext

  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([principalEmail])
  @@map("shares")
}

/// Owned by `auth`. One row per issued refresh token.
///
/// Only a SHA-256 is stored; the plaintext lives on the client. `familyId` is
/// what makes reuse detection possible: rotation issues a new row in the same
/// family, so presenting an already-rotated token identifies the family to kill
/// rather than just the one token to reject.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. Unique, so a replay is a lookup rather than a scan.
  tokenHash String @unique @map("token_hash")

  /// Every token descended from one login shares this. Killing a family is what
  /// turns a detected replay into a revoked session rather than a rejected
  /// request.
  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at")
  /// Set when this token is rotated away or the family is revoked. A row is
  /// never deleted here — `purge-expired-tokens` does that on a schedule, and
  /// until then the row is what lets a replay be *detected* rather than merely
  /// failing to match.
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
