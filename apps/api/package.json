{
  "name": "@dataroom/api",
  "version": "0.1.0",
  "private": true,
  "description": "Data room API \u2014 NestJS 11 + Prisma 6 + PostgreSQL",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nest start --watch --env-file .env",
    "debug": "nest start --debug --watch --env-file .env",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "test": "echo \"tests live in @dataroom/tests\" && exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@dataroom/shared": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "cron": "4.4.0",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  }
}
