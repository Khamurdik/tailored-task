# Copy to .env — never commit the real file.
# common/ validates this with zod at boot and crashes on anything missing.

NODE_ENV=development
PORT=3000

# Neon or local Postgres. Prisma 6 needs sslmode for hosted Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dataroom?schema=public"

# --- Tokens -----------------------------------------------------------------
# Bearer tokens only. The client keeps these in localStorage and sends the
# refresh token in a request body — this API sets no cookies, so there is no
# cookie secret and no CSRF secret here. See apps/api/src/auth/TODO.md.
# openssl rand -base64 32
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-differently"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- User provisioning ------------------------------------------------------
# There is no registration. These accounts are created by `prisma db seed`,
# which runs automatically after `db:migrate` and `db:reset`.
# JSON array so passwords and names containing , : or " are not a parse problem.
# Re-running the seed is idempotent and will NOT rewrite an existing password.
SEED_USERS='[{"email":"ana@example.com","password":"change-me-now","name":"Ana"},{"email":"bo@example.com","password":"change-me-too","name":"Bo"}]'

# Set true for one run to force-reset seeded users' passwords. Leave false.
SEED_FORCE_RESET=false

# --- Google sign-in (optional) ----------------------------------------------
# Links to an EXISTING seeded user by verified email. Never creates an account.
# Leave blank to disable; the API must still boot and serve password login.
GOOGLE_CLIENT_ID=

# --- S3 ---------------------------------------------------------------------
# Bucket must have Block Public Access ON. See storage/TODO.md.
AWS_REGION=eu-central-1
S3_BUCKET=dataroom-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_GET_TTL_SECONDS=60

# Comma-separated. No cookies means no credentialed CORS.
CORS_ORIGINS=http://localhost:5173

MAX_FILE_SIZE_BYTES=52428800
