# Copy to .env — never commit the real file.
# common/ validates this with zod at boot and crashes on anything missing.

NODE_ENV=development
PORT=3000

# Neon or local Postgres. Prisma 6 needs sslmode for hosted Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dataroom?schema=public"

# openssl rand -base64 32
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-differently"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3 — bucket must have Block Public Access ON. See storage/TODO.md.
AWS_REGION=eu-central-1
S3_BUCKET=dataroom-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_GET_TTL_SECONDS=60

# Comma-separated. In dev the Vite proxy makes this same-origin anyway.
CORS_ORIGINS=http://localhost:5173

MAX_FILE_SIZE_BYTES=52428800
