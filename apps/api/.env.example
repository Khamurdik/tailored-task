# Copy to .env — never commit the real file.
# common/ validates this with zod at boot and crashes on anything missing.

NODE_ENV=development
PORT=3000

# Neon or local Postgres. Prisma 6 needs sslmode for hosted Postgres.
# Port 5433, not 5432: docker-compose.test.yml deliberately avoids the default
# so it cannot collide with a Postgres already running on the machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dataroom?schema=public"

# --- Tokens -----------------------------------------------------------------
# Bearer tokens only. The client keeps these in localStorage and sends the
# refresh token in a request body — this API sets no cookies, so there is no
# cookie secret and no CSRF secret here. See apps/api/src/auth/TODO.md.
# openssl rand -base64 32   (run it twice — these must differ)
#
# These placeholders are UNDER the 16-character minimum on purpose. A fresh
# `cp .env.example .env` therefore fails to boot, naming these two variables,
# rather than starting happily with "replace-me" signing your tokens. The
# crash is the guard rail; do not lengthen the placeholders to quiet it.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-differently"
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

# --- User provisioning ------------------------------------------------------
# There is no registration. These accounts are created by `prisma db seed`,
# which runs automatically after `db:migrate` and `db:reset`.
# JSON array so passwords and names containing , : or " are not a parse problem.
# Re-running the seed is idempotent and will NOT rewrite an existing password.
# "admin": true is optional (default false) and is the ONLY way to get is_admin,
# which gates the /jobs endpoints.
#
# These six identities are the cast in REVIEW.md, and they are also what
# switches the demo room on: `prisma db seed` provisions the tree in
# prisma/demo-tree.ts only when the two rooms' owners — ana.ruiz@ and
# bo.lindqvist@ — exist. Drop either and the seed prints "Demo room skipped"
# and creates no nodes, which is what a real deployment wants. Cara and
# Dmytro hold one folder each, Erik holds nothing, and the admin reaches
# /jobs. The password below is the one REVIEW.md publishes: it is a demo
# credential and nothing else.
SEED_USERS='[{"email":"ana.ruiz@example.com","password":"review-2026-meridian","name":"Ana Ruiz"},{"email":"bo.lindqvist@example.com","password":"review-2026-meridian","name":"Bo Lindqvist"},{"email":"cara.mensah@example.com","password":"review-2026-meridian","name":"Cara Mensah"},{"email":"dmytro.kovalenko@example.com","password":"review-2026-meridian","name":"Dmytro Kovalenko"},{"email":"erik.sandberg@example.com","password":"review-2026-meridian","name":"Erik Sandberg"},{"email":"admin@example.com","password":"review-2026-meridian","name":"Administrator","admin":true}]'

# Set true for one run to force-reset seeded users' passwords. Leave false.
SEED_FORCE_RESET=false

# --- Google sign-in (optional) ----------------------------------------------
# Links to an EXISTING seeded user by verified email. Never creates an account.
# Leave blank to disable; the API must still boot and serve password login.
GOOGLE_CLIENT_ID=

# --- Scheduled jobs ---------------------------------------------------------
# Optional per-job overrides. Unset means the default in the JOBS registry.
# 6-field cron (seconds first), always interpreted as UTC.
# JOBS_CRON_REAP_PENDING_UPLOADS="0 0 * * * *"
# JOBS_CRON_HARD_DELETE_EXPIRED="0 0 2 * * *"
# JOBS_CRON_PURGE_EXPIRED_GRANTS="0 15 2 * * *"
# JOBS_CRON_PURGE_EXPIRED_TOKENS="0 30 2 * * *"
# JOBS_CRON_RECONCILE_ROLLUPS="0 45 2 * * *"
# JOBS_CRON_PRUNE_JOB_RUNS="0 0 3 * * 0"

# Comma-separated job ids to disable. They still appear in GET /jobs with
# nextRunAt: null, and can still be triggered manually.
JOBS_DISABLED=

# The scheduler must run on EXACTLY ONE instance — see jobs/TODO.md §5. Pin the
# service to minSize=1/maxSize=1. If you ever run more than one instance, set
# this false everywhere except one of them. Instances with it false still serve
# GET /jobs and manual triggers; they just register no cron jobs.
JOBS_SCHEDULER_ENABLED=true

# --- Uploads ----------------------------------------------------------------
# pdf-only  — magic bytes must be %PDF- at /complete. The default, and the only
#             value the product is designed around: the viewer is PDF-specific.
# all-files — accept any type. Enable deliberately; it widens the attack surface
#             (see files/TODO.md, "Why this is a toggle and not a constant").
# Either way the API only ever serves non-PDF bytes as an attachment, never
# inline — that rule is not part of the toggle.
UPLOAD_FILE_POLICY=pdf-only

# MAX_FILE_SIZE is NOT here. It is a compile-time constant in packages/shared,
# because the browser validates against the same number the API enforces — an
# env-only limit is one the client cannot know. See packages/shared/TODO.md.

# --- S3 ---------------------------------------------------------------------
# Shipped pointing at the MinIO in docker-compose.test.yml, so uploads work on a
# laptop with no AWS account and nothing here to fill in. The credentials below
# are that container's, hardcoded in the compose file; they are not secrets and
# they open nothing outside localhost.
#
# S3_ENDPOINT is the switch. Set — anything S3-compatible, MinIO here. Unset —
# real AWS, which is the deployed configuration; then AWS_REGION/S3_BUCKET name
# your bucket (Block Public Access ON, see storage/TODO.md) and the two keys
# below are an IAM user's. S3_FORCE_PATH_STYLE defaults to true whenever an
# endpoint is set, which is always what a bucket reached by host:port wants.
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
S3_BUCKET=dataroom
AWS_ACCESS_KEY_ID=dataroom
AWS_SECRET_ACCESS_KEY=dataroom-secret
S3_PRESIGN_GET_TTL_SECONDS=60

# Comma-separated. No cookies means no credentialed CORS.
CORS_ORIGINS=http://localhost:5173
