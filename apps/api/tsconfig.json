{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",

    // NestJS dependency injection reads design:paramtypes, which only exists
    // when both of these are on. Turning either off breaks the injector at
    // runtime with "Nest can't resolve dependencies", not at compile time.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Decorated constructor params and DTO fields are assigned by the
    // framework, not by the constructor body.
    "strictPropertyInitialization": false,

    // The Nest CLI consumes the emitted JS; isolatedModules would force
    // `export type` churn across every barrel file for no gain here.
    "isolatedModules": false,

    // Only "node". There is no test runner in this package — the whole suite
    // lives in @dataroom/tests — so a "jest" entry here fails the typecheck
    // with "Cannot find type definition file for 'jest'".
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },

  // No "test/**" — this package carries no tests. prisma/seed.ts is excluded
  // and typechecked separately by tsconfig.seed.json, because it is the one
  // file that must use explicit `.ts` import specifiers. See users/TODO.md.
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["prisma/seed.ts"]
}
